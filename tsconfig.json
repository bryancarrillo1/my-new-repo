{
  // One config for the whole monorepo. We never emit JS: `tsx` runs TS directly
  // in dev and `tsc` is used only as a type checker (`npm run typecheck`).
  "compilerOptions": {
    "target": "ES2023",
    // DOM types are for apps/web; the Node apps simply don't use them.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["packages/*/src", "packages/*/test", "apps/*/src", "apps/*/test", "apps/web/vite.config.ts", "scripts", "vitest.config.ts"]
}
