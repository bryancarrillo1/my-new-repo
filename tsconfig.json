{
  // One config for the whole monorepo. We never emit JS: `tsx` runs TS directly
  // in dev and `tsc` is used only as a type checker (`npm run typecheck`).
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["packages/*/src", "apps/*/src", "apps/*/test", "scripts"]
}
